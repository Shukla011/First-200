# Public client-side environment key from Flagsmith. Leave blank for unmeasured fallback.
VITE_FLAGSMITH_ENVIRONMENT_ID=
# Change this when starting a new experiment in the same environment.
VITE_FIRST_200_EXPERIMENT_RUN=first-200-v1
# Optional. Leave blank for Flagsmith Cloud. Use both values for self-hosted QA.
VITE_FLAGSMITH_API_URL=
VITE_FLAGSMITH_EVENTS_URL=
